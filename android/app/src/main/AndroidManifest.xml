<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Private URL scheme (CAPACITOR-PLAN.md → P4.2). Brought forward for
              the Google Calendar OAuth return; it now also carries notification
              deep links — `wivendor://orders?view={id}`, built by the same
              dashboard-relative convention. Parsed by
              src/platform/shell/deepLinks.ts, which keeps the scheme name.

              `launchMode="singleTask"` above is what makes these arrive as an
              `appUrlOpen` on the RUNNING instance instead of stacking a second
              copy of the app — and it is also what pops the Custom Tab off the
              task when the OAuth redirect brings us back to the front.

              Unlike an App Link this needs no server-side proof, so it works
              today: `adb shell am start -d "wivendor://services/calendar"`.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="wivendor" />
            </intent-filter>

            <!--
              App Links (CAPACITOR-PLAN.md → P4.2). Claims the real dashboard
              URLs, so a link in an email or a WhatsApp message opens the app
              rather than a browser tab the vendor then has to sign in to.

              Only `/dashboard` is claimed, not the whole host. The marketing
              pages, the storefront preview targets and anything else on
              vendor.wi-mall.com should keep opening in a browser — an app that
              swallows every link to its own domain is the reason people turn
              this feature off.

              ⚠ `autoVerify` is a REQUEST, not a guarantee. Android fetches
              https://vendor.wi-mall.com/.well-known/assetlinks.json at install
              time and only honours the filter if that file names this package
              AND the fingerprint of the certificate the installed build was
              signed with. `public/.well-known/assetlinks.json` in this repo
              carries the debug fingerprint, so a locally installed debug build
              verifies once the file is deployed. ⚠ A Play Store build will NOT,
              until the Play App Signing fingerprint is added to that file —
              see its README. Unverified, these links simply keep opening the
              browser; nothing breaks.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https"
                      android:host="vendor.wi-mall.com"
                      android:pathPrefix="/dashboard" />
            </intent-filter>
        </activity>

        <!--
            FCM presentation defaults (CAPACITOR-PLAN.md → P4.1). All three are
            read by the Firebase messaging SDK when it draws a notification the
            app never sees — which is every push that lands while the app is
            backgrounded or killed, i.e. the ones that matter most.

            ⚠ Without the icon line Android falls back to `android:icon`, and a
            status-bar icon is a MASK: only its alpha survives and every opaque
            pixel is painted white. The launcher icon is a filled bag, so the
            fallback is a featureless white blob. `ic_stat_wi_vendor` is the same
            mark reduced to line art, with the eyes and smile as real holes.

            ⚠ The channel id must match the one the client creates at runtime
            (src/platform/push.ts) AND the one the backend addresses
            (`ANDROID_CHANNELS.DEFAULT` in fcm-push.service.ts). It is only a
            fallback here — the backend names the channel on every send — but a
            payload that ever arrived without one would otherwise land in the
            SDK's own "Miscellaneous" channel, which the vendor cannot recognise
            and will mute.
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_wi_vendor" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/default_notification_channel_id" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Phase 4 capabilities (CAPACITOR-PLAN.md → P4.1, P4.3, P4.4). None of the
        plugins declares its own runtime permission; each ships only the service,
        the queries or the manifest stub it needs, so every grant below has to be
        asked for here.

        Each is requested at the point of use and never at startup — see the
        `requestPermissions` call in the matching src/platform/ module, and the
        "only the permission in use" rule in platform/media.ts.
    -->

    <!-- P4.1 — push. Runtime-granted from Android 13; implicit before that. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- P4.4 — "use my location" in the address picker. Coarse is enough to
         geocode to the right neighbourhood, so a vendor who grants only the
         approximate one still gets a filled address. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- P4.3 — camera and gallery.
         READ_MEDIA_* replaced READ_EXTERNAL_STORAGE in Android 13, hence the
         maxSdkVersion on the old one: without it the Play Console flags a
         storage permission the app cannot use on a modern device. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!--
        Declared NOT required, all three.

        ⚠ A `uses-permission` implies the matching `uses-feature` as REQUIRED
        unless it is overridden here, and Play uses that to decide which devices
        may install the app. Left implicit, a dashboard whose camera and GPS are
        conveniences would be hidden from every device lacking either — and a
        vendor who only ever reads orders on a cheap handset would be the one
        locked out.
    -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
</manifest>
