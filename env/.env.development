# ──────────────────────────────────────────────────────────────────────────────
# Development defaults — loaded by `npm run dev`.
#
# Non-secret localhost values only; this file is committed so a fresh clone runs
# without any setup. Your own keys and overrides go in
# env/.env.development.local, which is git-ignored and wins over this file.
# ──────────────────────────────────────────────────────────────────────────────

# Base URL of the backend API. Must end in /api.
VITE_API_BASE_URL=http://localhost:8022/api

# Base URL where uploaded files are served (defaults to the API origin /uploads).
# VITE_FILE_BASE_URL=

# Origin of the customer-facing storefront (the `landing` app). Used to build the
# public links a vendor copies or shares and the storefront preview iframes.
VITE_STOREFRONT_BASE_URL=http://localhost:3000

# Stripe publishable key (pk_test_…). Enables card payments for plan upgrades and
# credit top-ups; when unset the billing UI offers mobile money only. Put a real
# test key in env/.env.development.local.
# VITE_STRIPE_PUBLISHABLE_KEY=

# ─── Push notifications (FCM web push) ────────────────────────────────────────
# The MESSAGING Firebase project's web config (separate from the file-storage
# project). When ANY of these is unset, push stays inert and in-app notifications
# keep working. Put real values in env/.env.development.local, and keep them in
# sync with public/firebase-messaging-sw.js — a service worker cannot read Vite
# env vars.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_VAPID_KEY=

# ─── Bearer auth in a desktop browser (Phase 1) ───────────────────────────────
# `true` switches the app onto the MOBILE auth transport — bearer tokens against
# /api/auth/mobile/*, credentials:'omit', tokens in sessionStorage — so the
# native path can be exercised with no device. Read only when the dev server is
# running; a production build inlines it to false. Set it in .env.development.local.
# VITE_FORCE_MOBILE_AUTH=true
